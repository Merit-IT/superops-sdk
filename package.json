{
  "name": "@merit-it/superops-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK wrapper for the SuperOps PSA GraphQL API, with built-in caching, retry/backoff, and auto-pagination",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/merit-it/superops-sdk.git"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "rimraf": "^5.0.7",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
